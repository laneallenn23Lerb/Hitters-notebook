# Copy this file to .env and fill in your own values. Never commit .env.

# Port the app listens on (Render sets PORT automatically)
PORT=3000

# Set to "production" when deployed. Enables secure cookies.
NODE_ENV=development

# A long random string used to sign cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Database. Leave empty to use a local SQLite file (great for development).
# Set to your Postgres connection string in production (Render provides this).
DATABASE_URL=

# Local SQLite file location (only used when DATABASE_URL is empty)
SQLITE_PATH=./data/hitting-app.db
